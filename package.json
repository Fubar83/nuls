  "author": "Henrik Johansson (https://github.com/Fubar83)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Fubar83/nuls.git"
  },
  "bugs": {
    "url": "https://github.com/Fubar83/nuls/issues"
  },
  "homepage": "https://github.com/Fubar83/nuls#readme",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
